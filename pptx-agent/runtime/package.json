    "katex": "^0.18.7",
    "maplibre-gl": "^6.10.0",
    "monaco-editor": "^0.56.0",
    "office-addin-dev-certs": "^3.0.0",
    "onnxruntime-web": "^1.30.0",
    "pyodide": "^314.0.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
