{
  "name": "@rick-ppt/interactive-runtime",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/schema-compile.mjs && tsc --noEmit && vite build && node scripts/size-check.mjs",
    "test": "node scripts/schema-compile.mjs && vitest run",
    "test:e2e": "playwright test",
    "size": "node scripts/size-check.mjs",
    "manifests": "node scripts/manifests.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "jsep": "^1.4.0",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/node": "^22.18.0"
  }
}
