# Configure the production value as a Sites secret; never NEXT_PUBLIC_.
WORKER_TOKEN=
# Server-only administrator allowlist. Use a Sites-verified email, or pin the
# site-scoped user ID (takes precedence). Empty configuration denies everyone.
ADMIN_EMAIL=
ADMIN_USER_ID=
# Separate read-only local review credential. Never reuse WORKER_TOKEN.
REVIEW_TOKEN=
