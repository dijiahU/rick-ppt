# Configure the production value as a Sites secret; never NEXT_PUBLIC_.
WORKER_TOKEN=
# Server-only primary administrator. This identity cannot be removed in the UI.
# Additional administrators are managed from /admin and stored in D1.
# Use a Sites-verified email, or pin the site-scoped user ID (takes precedence).
ADMIN_EMAIL=
ADMIN_USER_ID=
# Separate read-only local review credential. Never reuse WORKER_TOKEN.
REVIEW_TOKEN=
# Exact HTTPS origin returned by Sites after site creation. Used only for
# absolute Open Graph and X image metadata.
SITE_ORIGIN=
